{
  "schema_version": "1.0",
  "suite": "rag-format-leakage",
  "description": "Retrieved facts are available to planning without exposing source metadata or document formatting as the user-facing presentation contract.",
  "cases": [
    {
      "id": "rag-duplicate-facts-deduplicate",
      "mode": "offline",
      "probe": "dedupe_context",
      "input": {
        "chunks": [
          {
            "text": "Same factual paragraph",
            "source": "a.pdf"
          },
          {
            "text": "Same factual paragraph",
            "source": "b.pdf"
          },
          {
            "text": "Distinct paragraph",
            "source": "c.pdf"
          }
        ]
      },
      "assertions": [
        {
          "op": "equals",
          "path": "count",
          "value": 2
        },
        {
          "op": "contains",
          "path": "texts",
          "value": "Distinct paragraph"
        }
      ]
    },
    {
      "id": "rag-public-stream-has-no-sources-event",
      "mode": "offline",
      "probe": "sse_event_contract",
      "input": {
        "events": [
          "token",
          "done"
        ]
      },
      "assertions": [
        {
          "op": "not_contains",
          "path": "events",
          "value": "sources"
        }
      ],
      "bug": {
        "status": "regression_guard",
        "root_cause": "Raw retrieval sources remain internal and must not become a public SSE presentation event."
      }
    }
  ]
}
