# Cấu hình inference: sao chép file này thành .env.
# config/settings.py đọc .env khi chạy từ thư mục gốc project.

# Kết nối và model Ollama; có thể đổi model bằng OLLAMA_CHAT_MODEL.
# API Python chạy trên máy chủ, Ollama mở cổng 11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b

# Giữ model trong bộ nhớ và warmup khi khởi động inference.
OLLAMA_KEEP_ALIVE=24h
OLLAMA_WARMUP_ENABLED=true

# Context và ngân sách đầu ra.
OLLAMA_NUM_CTX=4096
OLLAMA_SHORT_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=1024
OLLAMA_LONG_NUM_PREDICT=1536
OLLAMA_CONTEXT_RESERVE_TOKENS=128
OLLAMA_THINK=false

# HTTP client gọi Ollama.
API_TIMEOUT_SECONDS=300
API_CONNECT_TIMEOUT_SECONDS=10
API_MAX_CONNECTIONS=20
